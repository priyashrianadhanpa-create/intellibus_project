# IntelliBus AI Production Environment Configuration
PROJECT_NAME="IntelliBus AI Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL="postgresql://postgres:postgres@db:5432/intellibus"

# SQLite Dev Fallback (Optional)
# DATABASE_URL="sqlite:///./intellibus.db"

# MQTT IoT Telemetry Broker
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX="intellibus/telemetry"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost", "http://localhost:5173", "http://localhost:8000"]
