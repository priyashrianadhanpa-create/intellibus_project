      <tr>
        <td><strong>Backend API</strong></td>
        <td>FastAPI, Uvicorn, Python 3.12, Pydantic v2, WebSockets</td>
      </tr>
      <tr>
        <td><strong>Database & ORM</strong></td>
        <td>PostgreSQL 15, PostGIS 3.3, SQLAlchemy 2.0, Alembic</td>
      </tr>
      <tr>
        <td><strong>Machine Learning Core</strong></td>
        <td>Custom Python Models: Haversine ETA Predictor, Dijkstra Route Optimizer, Safety Anomaly Detector</td>
      </tr>
      <tr>
        <td><strong>Frontend Framework</strong></td>
        <td>React 19, Vite, TypeScript, React Router v7, Zustand, Tailwind CSS v4, Lucide Icons</td>
      </tr>
      <tr>
        <td><strong>Maps & PWA</strong></td>
        <td>Leaflet, React-Leaflet, Web Speech API, Service Workers (PWA)</td>
      </tr>
    </tbody>
